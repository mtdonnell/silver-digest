# Copy this file to ".env" (no .example) and fill it in.
# NEVER commit .env to git or share it. It holds live credentials.

# --- Stores ---------------------------------------------------------------
# Add STORE3_*, STORE4_* etc. later if you open more locations.
# Use a DEDICATED report-only Back Office user for each store, not your owner
# login. That way rotating your own password never breaks the automation, and
# a leaked bot credential cannot change prices or refund transactions.

STORE1_NAME=Main Street
STORE1_USER=reports-bot@yourdomain.com
STORE1_PASS=changeme

STORE2_NAME=Second Shop
STORE2_USER=reports-bot2@yourdomain.com
STORE2_PASS=changeme


# ==========================================================================
#  RETENTION  (optional -- these are the defaults)
# ==========================================================================
# Housekeeping runs automatically at the end of every scheduled job. Preview
# what it would remove, without deleting anything:
#     python silver_report.py --cleanup
# Then actually delete:
#     python silver_report.py --cleanup --force
#
# history.csv is NEVER pruned. It is the one file here you cannot regenerate.

# Raw daily exports. Just over a year, so year-on-year comparison still has
# the original file to check against. Aged by the DATE IN THE FILENAME, not
# mtime -- re-pulling an old day must not make it look new.
#KEEP_DAILY_EXPORTS_DAYS=450

# Ad-hoc range exports from bot queries. Short, because you can always ask the
# bot again. Aged by mtime, since the filename holds the period QUERIED rather
# than when it was pulled.
#KEEP_RANGE_EXPORTS_DAYS=14

# Failure screenshots + HTML dumps. These are the real flood risk: roughly
# 300KB per store per failed run, so a week-long portal outage writes several MB
# of near-identical PNGs.
#KEEP_FAILURES_DAYS=30

# Backups of history.csv, only written when the column set changes.
#KEEP_HISTORY_BACKUPS=5


# ==========================================================================
#  DELIVERY
# ==========================================================================
# Pick your channels here. Comma-separated, any combination:
#
#     telegram         full breakdown to your phone. Free, ~2 min setup.
#     smtp             full breakdown by email
#     sms_gateway      text, via your carrier's free email-to-SMS bridge
#     twilio_sms       real SMS (costs money, needs A2P 10DLC registration)
#     twilio_whatsapp  WhatsApp (needs an APPROVED TEMPLATE -- read below)
#
# Telegram is the best default for an always-on box: no carrier, no SMTP, no
# registration, no length limit, and it is the only channel that gets the FULL
# breakdown rather than a truncated one.
#
# WORTH DOING: add a second channel once you can. With only one, a broken
# token means no digest AND no warning that there is no digest -- the whole
# point of the [CHECK] alert is that silence never means success.
#
# If you leave DIGEST_CHANNELS blank, the script infers it from whatever you
# filled in below.

DIGEST_CHANNELS=telegram


# --- Telegram (recommended) -----------------------------------------------
# Setup, about two minutes:
#   1. In Telegram, message @BotFather and send:  /newbot
#   2. Answer its two prompts (a display name, then a username ending in "bot")
#   3. It replies with a token like 123456789:AAHx...  -- paste it below
#   4. Find your new bot in Telegram and send it any message ("hi" is fine).
#      This matters: a bot is NOT allowed to message you until you message it.
#   5. Run:  python silver_report.py --telegram-setup
#      It prints the TELEGRAM_CHAT_ID line to paste below.

TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=


# --- Email (optional; required for the smtp AND sms_gateway channels) -----
# Leave this alone if you are only using Telegram. Add it later as your
# second channel -- it is the cheapest way to stop depending on one service.
# Gmail example. You must create an APP PASSWORD (not your normal password) at
# https://myaccount.google.com/apppasswords -- requires 2FA on the Google account.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Where the full digest goes. Comma-separated for multiple recipients.
DIGEST_TO=you@gmail.com


# --- Text via carrier gateway ---------------------------------------------
# Free, instant to set up, no account. Put your number @ your carrier's domain.
# Gets the SHORT digest (one line per store + total), not the full breakdown.
#   Verizon   5551234567@vtext.com
#   AT&T      5551234567@txt.att.net
#   T-Mobile  5551234567@tmomail.net
#   Google Fi 5551234567@msg.fi.google.com
# Caveat: delivery is best-effort with no receipt, and carriers are slowly
# retiring these gateways. Good enough to start, worth revisiting later.

SMS_GATEWAY_TO=PUTYOURNUMBERHERE@vtext.com


# --- Twilio SMS (optional) ------------------------------------------------
# Real SMS with delivery receipts. Roughly $0.008/segment plus ~$1.15/mo for
# the number. HEADS UP: sending to US numbers from a long code requires A2P
# 10DLC brand + campaign registration. It takes a few days, and until it
# clears, carriers FILTER your messages rather than rejecting them -- so they
# vanish without an error. Register before you depend on this.

#TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_AUTH_TOKEN=your-auth-token
#TWILIO_SMS_FROM=+15559999999
#TWILIO_SMS_TO=+15551234567


# --- Twilio WhatsApp (optional) -------------------------------------------
# READ THIS OR IT WILL BREAK ON DAY TWO.
#
# WhatsApp only allows free-form business messages inside a 24-hour window
# that the CUSTOMER opens by messaging you first. A 3:15am digest is always
# outside that window, so it can ONLY be delivered as a pre-approved template.
# Since April 2025, templates must be sent by Content SID -- passing the text
# in the message body fails outright.
#
# The trap: Twilio's WhatsApp SANDBOX opens a 24-hour window as soon as you
# text it the "join <code>" phrase, so free-form sends test green and then
# stop working the next day. This script never sends free-form to WhatsApp,
# so it behaves the same in sandbox and production.
#
# Setup, in order:
#   1. Get a WhatsApp sender approved in Twilio (needs Meta business
#      verification -- allow a week).
#   2. Create a message template with EXACTLY (stores + 2) variables: one
#      headline, one per store, one for the combined total. With the two
#      stores above, that is four:
#          {{1}}
#          {{2}}
#          {{3}}
#          {{4}}
#      Variable 1 is the headline and carries the [CHECK] marker when a
#      capture fails, so you do not need a separate failure template.
#      The count must never vary between sends -- Meta rejects a template
#      whose parameter count differs from the approved definition, so the
#      script pads unused slots with "-" rather than omitting them.
#      ADDING A THIRD STORE MEANS GETTING A NEW 5-VARIABLE TEMPLATE APPROVED.
#   3. Wait for Meta to approve it (minutes to a day).
#   4. Paste its Content SID (starts with HX) below.

#TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_AUTH_TOKEN=your-auth-token
#TWILIO_WHATSAPP_FROM=+15559999999
#TWILIO_WHATSAPP_TO=+15551234567
#TWILIO_WHATSAPP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
